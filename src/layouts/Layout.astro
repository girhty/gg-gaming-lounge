---
const {
  title = 'GG Gaming lounge | Basra',
  description = 'GG Gaming lounge — where legends are born. PlayStation, PC gaming, esports tournaments, sweets and drinks in Basra.',
  image = 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/801220093_18618414220026593_8290179572510053897_n.jpg?stp=dst-jpg_s150x150_tt6'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#070711" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Arabic:wght@400;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: #070711;
    color: #f8fafc;
    font-family: Inter, sans-serif;
    overflow-x: hidden;
  }
  ::selection { background: #a8ff35; color: #070711; }
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .8s ease, transform .8s ease;
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");
    opacity: .15;
    pointer-events: none;
  }
  .glass { background: rgba(17,17,36,.65); border: 1px solid rgba(255,255,255,.1); backdrop-filter: blur(18px); }
  .gradient-text { background: linear-gradient(100deg,#a8ff35,#22d3ee 48%,#a78bfa); -webkit-background-clip:text; background-clip:text; color:transparent; }
</style>