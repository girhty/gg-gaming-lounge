<section id="visit" class="mx-auto max-w-7xl px-5 pb-24 lg:px-8">
  <div class="reveal grid overflow-hidden rounded-[2rem] border border-white/10 bg-panel lg:grid-cols-[1.05fr_.95fr]">
    <div class="p-8 sm:p-12">
      <p class="text-xs font-bold uppercase tracking-[.3em] text-electric">Come through</p>
      <h2 class="mt-4 font-display text-4xl font-bold sm:text-5xl">Find your<br /><span class="text-slate-500">next match.</span></h2>
      <div class="mt-10 space-y-7">
        <div class="flex gap-4"><span class="text-xl">⌖</span><div><p class="font-semibold">Address</p><p class="mt-1 font-arabic text-sm leading-7 text-slate-400">حي عمان - قرب مطعم بربين<br />Basrah, Basra Governorate, 61001</p></div></div>
        <div class="flex gap-4"><span class="text-xl">◷</span><div><p class="font-semibold">Opening status</p><p class="mt-1 text-sm text-electric">● Open now</p><p class="mt-1 text-xs text-slate-500">Hours may vary — check Instagram for updates</p></div></div>
      </div>
      <a href="https://www.google.com/maps/search/?api=1&query=GG+Gaming+lounge+Basra" target="_blank" rel="noreferrer" class="mt-10 inline-flex rounded-full border border-white/20 px-6 py-3 text-sm font-bold transition hover:border-electric hover:text-electric">Open in Google Maps ↗</a>
    </div>
    <div class="relative min-h-[330px] overflow-hidden bg-[#171730]">
      <div class="absolute inset-0 opacity-40" style="background-image:linear-gradient(rgba(168,255,53,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(168,255,53,.12) 1px,transparent 1px);background-size:45px 45px;"></div>
      <div class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center">
        <span class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-electric text-2xl text-ink shadow-[0_0_50px_rgba(168,255,53,.5)]">⌖</span>
        <span class="rounded-full border border-white/10 bg-ink/80 px-4 py-2 text-xs font-bold">GG Gaming lounge</span>
      </div>
    </div>
  </div>
</section>