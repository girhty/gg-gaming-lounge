---
const { posts } = Astro.props;
---
<section id="feed" class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
  <div class="reveal mb-12 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div><p class="mb-4 text-xs font-bold uppercase tracking-[.3em] text-electric">From the community</p><h2 class="font-display text-4xl font-bold sm:text-5xl">The feed is <span class="gradient-text">alive.</span></h2></div>
    <a href="https://www.instagram.com/gg_basra/" target="_blank" rel="noreferrer" class="text-sm font-semibold text-slate-300 transition hover:text-electric">@gg_basra on Instagram ↗</a>
  </div>
  <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
    {posts.map((post, index) => (
      <a href="https://www.instagram.com/gg_basra/" target="_blank" rel="noreferrer" class:list={['reveal group relative aspect-square overflow-hidden rounded-2xl bg-panel', index === 1 || index === 4 ? 'md:translate-y-8' : '']} style={`transition-delay:${index * 70}ms`} aria-label={`View Instagram post: ${post.caption}`}>
        <img src={post.image} alt={post.caption} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
        <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/20 to-transparent p-4 opacity-0 transition duration-300 group-hover:opacity-100">
          <p class="line-clamp-3 text-right font-arabic text-sm leading-6 text-white">{post.caption}</p>
          <span class="mt-3 text-xs text-slate-300">♡ {post.likes} likes &nbsp; · &nbsp; View post ↗</span>
        </div>
      </a>
    ))}
  </div>
</section>